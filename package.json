{
  "name": "senangwebs-chatbot",
  "version": "1.4.0",
  "description": "Lightweight JavaScript library with OpenRouter API integration for AI-powered conversations.",
  "main": "dist/swc.js",
  "browser": "dist/swc.js",
  "style": "dist/swc.css",
  "exports": {
    ".": {
      "require": "./dist/swc.js",
      "default": "./dist/swc.js"
    },
    "./dist/swc.css": "./dist/swc.css",
    "./dist/swc.js": "./dist/swc.js",
    "./dist/swc.min.css": "./dist/swc.min.css",
    "./dist/swc.min.js": "./dist/swc.min.js"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "LICENSE.md",
    "SECURITY.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "test": "node --test tests/unit/state.test.cjs tests/unit/transport.test.cjs",
    "test:browser": "playwright test",
    "check:package": "node scripts/check-package.cjs"
  },
  "keywords": [
    "chatbot",
    "customer support",
    "web",
    "customizable"
  ],
  "author": "a-hakim",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.25.8",
    "@babel/preset-env": "^7.25.8",
    "@playwright/test": "^1.63.0",
    "babel-loader": "^9.2.1",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "esbuild": "^0.28.2",
    "mini-css-extract-plugin": "^2.9.1",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "dompurify": "^3.4.16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-hakim/senangwebs-chatbot.git"
  },
  "bugs": {
    "url": "https://github.com/a-hakim/senangwebs-chatbot/issues"
  },
  "homepage": "https://github.com/a-hakim/senangwebs-chatbot#readme"
}
